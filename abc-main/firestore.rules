rules_version = '2';

service cloud.firestore {

    match /databases/{database}/documents {


        /* ==========================================
           ADMIN
        ========================================== */

        match /admins/{uid} {

            allow read:
                if request.auth != null
                && request.auth.uid == uid;

            allow write:
                if false;
        }


        /* ==========================================
           USERS
        ========================================== */

        match /users/{employeeId} {

            /*
             * Người dùng đã đăng nhập Firebase
             * mới được đọc.
             */

            allow read:
                if request.auth != null;


            /*
             * Chỉ admin có document
             * admins/{uid}
             * mới được tạo/sửa/xóa.
             */

            allow create, update, delete:
                if isAdmin();

        }


        /* ==========================================
           ADMIN FUNCTION
        ========================================== */

        function isAdmin() {

            return request.auth != null
                &&
                exists(
                    /databases/$(database)
                    /documents/admins/
                    $(request.auth.uid)
                );

        }


        /* ==========================================
           DEFAULT DENY
        ========================================== */

        match /{document=**} {

            allow read, write:
                if false;

        }

    }
}
