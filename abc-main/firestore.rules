rules_version = '2';

service cloud.firestore {

    match /databases/{database}/documents {


        /* ==========================================
           ADMIN
        ========================================== */

        match /admins/{uid} {

            allow read:
                if request.auth != null
                && request.auth.uid == uid;

            allow write:
                if false;
        }


        /* ==========================================
           USERS
        ========================================== */

        match /users/{employeeId} {


            /*
             * User phải đăng nhập Anonymous Firebase
             * mới được đọc dữ liệu của chính mình.
             */

            allow get:
                if request.auth != null;


            /*
             * Không cho user tự ý tạo/xóa.
             */

            allow create, delete:
                if isAdmin();


            /*
             * Admin được sửa toàn bộ.
             *
             * User chỉ được sửa session của
             * chính mình và không được đổi
             * employeeId/name/active...
             */

            allow update:
                if isAdmin()
                ||
                (
                    request.auth != null
                    &&
                    request.resource.data.employeeId
                        == resource.data.employeeId
                    &&
                    request.resource.data.name
                        == resource.data.name
                    &&
                    request.resource.data.active
                        == resource.data.active
                    &&
                    request.resource.data.role
                        == resource.data.role
                    &&
                    request.resource.data.color
                        == resource.data.color
                    &&
                    request.resource.data.startDate
                        == resource.data.startDate
                    &&
                    request.resource.data.endDate
                        == resource.data.endDate
                    &&
                    request.resource.data.activeSession
                        != null
                    &&
                    request.resource.data.activeSession
                        != resource.data.activeSession
                );
        }


        /* ==========================================
           ADMIN CHECK
        ========================================== */

        function isAdmin() {

            return request.auth != null
                &&
                exists(
                    /databases/$(database)
                    /documents/admins/
                    $(request.auth.uid)
                );
        }


        /* ==========================================
           DEFAULT DENY
        ========================================== */

        match /{document=**} {

            allow read, write:
                if false;
        }

    }
}
