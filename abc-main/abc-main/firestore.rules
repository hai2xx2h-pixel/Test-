rules_version = '2';

service cloud.firestore {

    match /databases/{database}/documents {


        /* ==========================================
           ADMIN
        ========================================== */

        match /admins/{uid} {

            allow read:
                if request.auth != null
                && request.auth.uid == uid;

            allow write:
                if false;
        }


        /* ==========================================
           USERS
        ========================================== */

        match /users/{employeeId} {

            /*
             * Người dùng đã đăng nhập Firebase
             * mới được đọc.
             */

            allow read:
                if request.auth != null;


            /*
             * Chỉ admin có document
             * admins/{uid}
             * mới được tạo/sửa/xóa.
             */

            allow create, delete:
                if isAdmin();


            /*
             * Ứng dụng nhân viên chỉ được ghi session
             * và thời điểm đăng nhập; mọi trường hồ sơ
             * khác vẫn chỉ do quản trị viên thay đổi.
             */
            allow update:
                if isAdmin() || isSessionUpdate();

        }


        /* ==========================================
           ADMIN FUNCTION
        ========================================== */

        function isAdmin() {

            return request.auth != null
                &&
                exists(
                    /databases/$(database)
                    /documents/admins/
                    $(request.auth.uid)
                );

        }


        function isSessionUpdate() {

            return request.auth != null
                && request.resource.data.diff(resource.data)
                    .affectedKeys()
                    .hasOnly(['activeSession', 'lastLogin']);

        }


        /* ==========================================
           DEFAULT DENY
        ========================================== */

        match /{document=**} {

            allow read, write:
                if false;

        }

    }
}
